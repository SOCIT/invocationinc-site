# The hub site has no checkout and needs no secrets.
# No environment variables are required for the existing pages.
NEXT_PUBLIC_SITE_URL=https://invocationinc.com

# Care Split checkout only. One-time prices. Do not put secret values in this file.
# STRIPE_SECRET_KEY is the existing Invocation Inc Stripe secret. It is not a new account.
# STRIPE_PRICE_CARE_SPLIT_INTERVIEWS must be an existing one-time USD price of $24.99 (five interviews).
# STRIPE_PRICE_CARE_SPLIT_REVIEW must be an existing one-time USD price of $100 or more.
# Leave them unset until Jonah adds test-mode price ids. Do not create live products from the app.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_CARE_SPLIT_INTERVIEWS=
# STRIPE_PRICE_CARE_SPLIT_REVIEW=

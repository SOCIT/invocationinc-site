# The hub site has no checkout and needs no secrets.
# No environment variables are required for the existing pages.
NEXT_PUBLIC_SITE_URL=https://invocationinc.com

# Care Split checkout only. One-time price. Do not put secret values in this file.
# STRIPE_SECRET_KEY is the existing Invocation Inc Stripe secret. It is not a new account.
# STRIPE_PRICE_CARE_SPLIT_INTERVIEWS must be an existing one-time USD price of $9.99 (five interviews).
# Leave it unset until Jonah adds a test-mode price id. Do not create live products from the app.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_CARE_SPLIT_INTERVIEWS=
